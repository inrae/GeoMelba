<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Fiche d'identité du bassin versant</title>
    <link rel="stylesheet" href="style.css"/>
</head>
<body>
    <content>
    <div class="regular">
        <h1>Fiche d'identité du bassin versant {{ watershed_name }} pour la saison {{ season }}</h1>
        <h3>Tour {{ count }} </h3>
        </div>
    <div class="greenbar">
        <img src="{{ output }}/ex_evolution.png">
        <img src="{{ output }}/change.png">
    </div>
    <div class="regular">
        <h2 id="exutoire">Valeur à l'exutoire : {{ exutoire }} %
            {% if evolution_exutoire == 0 %}
                <span class='better'>⬊</span>
            {% elif evolution_exutoire == 1 %}
                <span class='bad'>⬈</span>
            {% elif evolution_exutoire == 2 %}
                <span class='equal'>=</span>
            {% elif evolution_exutoire == 3 %}
                <span></span>
            {% endif %}
        </h2>
        <h2>Statistiques</h2>
        <div id=stat>
            <h3>Surfaces cumulées par type d'occupation du sol (ha)</h3> 
            <div id='exploitation'>
                <ul>
                    {% for key in keys_surface %}
                        <li class="list_item">
                            <span class="key">{{ key.replace('_', ' ') }} : </span>
                            <span class="value">
                                <span class="surf">
                                    {{ dict_surface[key]|round(1) }} ha
                                </span>
                                <span class="percent">   
                                    {% if percent_surface[key] %}
                                        {{ percent_surface[key] }}%
                                    {% else %}
                                        0%
                                    {% endif %}
                                </span>
                                {% if ev_surface[key] == 0 %}
                                <span>⬊</span>
                                {% elif ev_surface[key] == 1 %}
                                    <span>⬈</span>
                                {% elif ev_surface[key] == 2 %}
                                    <span class="equal">=</span>
                                {% elif ev_surface[key] == 3 %}
                                    <span></span>
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            {% if keys_practices != None%}
            <h3>Surfaces cumulées par type de pratiques (ha)</h3> 
            <div id='practices'>
                <ul>
                {% for key in keys_practices %}
                    <li class="list_item">
                        <span class="key">{{ key.replace('_', ' ') }} : </span>
                        <span class="value">
                            <span class="surf">
                            {{ dict_practices[key]|round(1) }} ha
                            </span>
                            <span class="percent">
                                {{ percent_practices[key] }}%
                            </span>
                            {% if ev_practices[key] == 0 %}
                                <span>⬊</span>
                            {% elif ev_practices[key] == 1 %}
                                <span>⬈</span>
                            {% elif ev_practices[key] == 2 %}
                                <span class="equal">=</span>
                            {% elif ev_practices[key] == 3 %}
                                <span></span>
                            {% endif %}
                        </span>
                    </li>
                {% endfor %}
                </ul>
            </div>
            {% endif %}
            <h3>Longueurs cumulées par élément paysagé (m)</h3>
            <div id='paysage'>
                <ul>
                    {% for key in keys_lineaire %}
                        <li class="list_item">
                            <span class="key">{{ key.replace('_', ' ') }} : </span>
                            <span class="value">
                                <span class="surf">
                                    {{ dict_lineaire[key]|round(1) }} m
                                </span>
                                {% if ev_lineaire[key] == 0 %}
                                    <span>⬊</span>
                                {% elif ev_lineaire[key] == 1 %}
                                    <span>⬈</span>
                                {% elif ev_lineaire[key] == 2 %}
                                    <span class="equal">=</span>
                                {% elif ev_lineaire[key] == 3 %}
                                    <span></span>
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    </content>
    <footer>
        {% if watershed_name == "gimond" or watershed_name == "beaujolais"%}
            <img src="templates/{{ watershed_name }}_footer.jpg" style="height: 1.5cm"/>
        {% else %}
            <img src="templates/gimond_footer.jpg" style="height: 1.5cm;"/>
        {% endif %}
    </footer>
    <div class="page-break"></div>
</body>
</html>
